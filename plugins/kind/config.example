# Настройки плагина kind. Формат КЛЮЧ=значение, без пробелов вокруг "=" и без кавычек.
# Изменения вступают в силу при следующем запуске agentcell (перезапуск VM не нужен).

# Срок токена агента в кластере: число и буква h (часы) или m (минуты), например 8h или 90m.
# Истёк — перезапустите agentcell.
KIND_TOKEN_TTL=8h
